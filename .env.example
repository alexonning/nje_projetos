# Selecione local ou supabase. Altere no arquivo local .env.local.
DATABASE_PROVIDER=local
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Cole aqui a connection string PostgreSQL do Supabase (Database > Connect).
# Para execução serverless, prefira o pooler de transação e SSL.
SUPABASE_DATABASE_URL=

# Configure estes três valores uma única vez antes de executar auth:bootstrap.
# Remova a senha do ambiente após a criação do administrador inicial.
AUTH_BOOTSTRAP_ADMIN_NAME=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
